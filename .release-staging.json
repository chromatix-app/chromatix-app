{
  "preRelease": "beta",
  "git": {
    "requireCleanWorkingDir": true,
    "tag": true,
    "tagName": "${version}"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "echo !!! Have you updated the changelog? !!!",
      "git checkout staging",
      "git pull",
      "git merge develop"
    ],
    "after:release": ["git checkout develop"]
  }
}
