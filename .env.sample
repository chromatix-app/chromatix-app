# USED TO DEFINE THE APP ENVIRONMENT. CAN BE 'local', 'preview', OR 'production'.
VITE_ENV=local

# USED TO DEFINE THE CONTACT EMAIL ADDRESS DISPLAYED IN THE APP.
VITE_EMAIL_ADDRESS=email@email.com

# USED TO PRE-POPULATE THE JELLYFIN LOGIN FORM DURING DEVELOPMENT. NOT USED IN PRODUCTION.
VITE_JELLY_SERVER=http://192.168.0.1:8096
VITE_JELLY_USERNAME=YourJellyfinUsername
VITE_JELLY_PASSWORD=YourJellyfinPassword

# USED TO DEFINE THE TINIFY API KEY FOR IMAGE COMPRESSION. NOT USED IN PRODUCTION.
TINIFY_API_KEY=YourTinifyAPIKey

# USED TO AUTHENTICATE THE FRONTEND'S REQUESTS TO THE api/tags/add ENDPOINT.
# MUST MATCH THE TAGS_ADD_API_KEY VALUE SET ON THE API SIDE.
VITE_TAGS_ADD_API_KEY=YourTagsAddApiKey

# USED BY api/tags/add TO AUTHENTICATE INCOMING REQUESTS.
# MUST MATCH THE VITE_TAGS_ADD_API_KEY VALUE ABOVE.
TAGS_ADD_API_KEY=YourTagsAddApiKey

# USED BY api/tags/read TO AUTHENTICATE INCOMING REQUESTS. NOT USED BY THE FRONTEND —
# ONLY FOR MANUALLY CHECKING STORED TAGS (E.G. VIA CURL/POSTMAN), SO THERE IS NO
# VITE_ COUNTERPART; KEEP THIS OUT OF THE PUBLIC FRONTEND BUILD.
TAGS_READ_API_KEY=YourTagsReadApiKey
