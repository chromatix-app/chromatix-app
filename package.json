{
  "name": "chromatix",
  "version": "0.52.0-beta.8",
  "description": "",
  "license": "UNLICENSED",
  "private": "true",
  "homepage": "/",
  "scripts": {
    "start": "REACT_APP_VERSION=$npm_package_version REACT_APP_DATE=$(date +%s) react-scripts start",
    "start-https": "REACT_APP_VERSION=$npm_package_version REACT_APP_DATE=$(date +%s) HTTPS=true react-scripts start",
    "build": "REACT_APP_VERSION=$npm_package_version REACT_APP_DATE=$(date +%s) react-scripts build",
    "release:stage": "release-it --config .release-staging.json",
    "release:staging": "npm run release:stage",
    "release:prod": "release-it --config .release-production.json",
    "release:production": "npm run release:prod",
    "image:compress": "node lib/image-to-webp.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "react-scripts test",
    "test:all": "react-scripts test --watchAll=false",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "**/*.{json,css,scss,md}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@rematch/core": "^2.2.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.11.0",
    "chroma-js": "^3.1.2",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "fast-xml-parser": "^5.2.5",
    "formik": "^2.4.6",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1",
    "sass": "^1.89.2",
    "semver": "^7.7.2",
    "sonner": "^2.0.6",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "release-it": "^17.11.0",
    "sharp": "^0.34.3",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5",
    "webpack": "^5.100.2"
  },
  "overrides": {
    "react-refresh": "0.11.0"
  },
  "browserslist": {
    "development": [
      "last 1 versions"
    ],
    "production": [
      "last 2 versions",
      ">0.25%",
      "ie 11",
      "ios 7",
      "android 4"
    ]
  }
}
