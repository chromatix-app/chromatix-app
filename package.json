{
  "name": "chromatix",
  "version": "0.70.0-beta.3",
  "description": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "homepage": "/",
  "scripts": {
    "start": "npm run dev",
    "dev": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite",
    "build": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite build",
    "build:analyze": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) ANALYZE=true vite build",
    "preview": "vite preview",
    "release:stage": "release-it --config .release-staging.json",
    "release:staging": "npm run release:stage",
    "release:prod": "release-it --config .release-production.json",
    "release:production": "npm run release:prod",
    "images:new": "npm run images:convert:new && npm run images:tinify:new",
    "images:all": "npm run images:convert:all && npm run images:tinify:all",
    "images:convert:new": "node lib/image-to-webp.mjs --skip-existing",
    "images:convert:all": "node lib/image-to-webp.mjs",
    "images:tinify:new": "node lib/image-tinify.mjs --skip-existing",
    "images:tinify:all": "node lib/image-tinify.mjs",
    "svg:compress:new": "node lib/svg-compress.mjs --skip-existing",
    "svg:compress:all": "node lib/svg-compress.mjs",
    "css:sort": "postcss src/**/*.scss src/**/*.module.scss --replace",
    "knip": "knip --no-config-hints",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:clear": "rm -f .eslintcache",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run knip && npm run lint && npm run prettier && npm run typecheck",
    "test": "vitest --silent",
    "test:verbose": "vitest",
    "test:all": "vitest run --silent",
    "test:all:verbose": "vitest run",
    "test:e2e": "node lib/run-timed.js playwright test",
    "test:e2e:login": "node tests/setup/auth.login.mjs",
    "test:e2e:home": "node lib/run-timed.js playwright test tests/pages/1.home.spec.ts",
    "test:e2e:setup": "node lib/run-timed.js playwright test tests/pages/2.setup.auth.spec.ts",
    "test:e2e:library": "node lib/run-timed.js playwright test tests/pages/3.library.auth.spec.ts",
    "test:e2e:settings": "node lib/run-timed.js playwright test tests/pages/4.settings.auth.spec.ts",
    "test:e2e:ui": "node lib/run-timed.js playwright test tests/pages/5.ui.auth.spec.ts",
    "test:e2e:windows": "node lib/run-timed.js playwright test tests/pages/6.windows.auth.spec.ts",
    "test:e2e:player": "node lib/run-timed.js playwright test tests/pages/7.player.auth.spec.ts",
    "test:e2e:update": "node lib/run-timed.js playwright test --update-snapshots",
    "test:e2e:update:home": "node lib/run-timed.js playwright test tests/pages/1.home.spec.ts --update-snapshots",
    "test:e2e:update:setup": "node lib/run-timed.js playwright test tests/pages/2.setup.auth.spec.ts --update-snapshots",
    "test:e2e:update:library": "node lib/run-timed.js playwright test tests/pages/3.library.auth.spec.ts --update-snapshots",
    "test:e2e:update:settings": "node lib/run-timed.js playwright test tests/pages/4.settings.auth.spec.ts --update-snapshots",
    "test:e2e:update:ui": "node lib/run-timed.js playwright test tests/pages/5.ui.auth.spec.ts --update-snapshots",
    "test:e2e:update:windows": "node lib/run-timed.js playwright test tests/pages/6.windows.auth.spec.ts --update-snapshots",
    "test:e2e:gui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-report",
    "doctor": "react-doctor",
    "doctor:all": "react-doctor --yes",
    "doctor:json": "react-doctor --yes --json",
    "doctor:verbose": "react-doctor --yes --verbose",
    "prepare": "husky"
  },
  "lint-staged": {
    "ignore": [
      "**/_archived/**"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "**/*.{json,css,scss,md}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.6",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@radix-ui/react-popover": "^1.1.22",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-toggle-group": "^1.1.18",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@rematch/core": "^2.2.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "axios": "^1.18.1",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dashjs": "^5.2.0",
    "dayjs": "^1.11.21",
    "input-otp": "^1.4.2",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^5.3.4",
    "sass": "^1.101.7",
    "semver": "^7.8.5",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/chroma-js": "^3.1.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.22",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "postcss-sorting": "^10.0.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.1",
    "release-it": "^20.2.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tinify": "^1.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
