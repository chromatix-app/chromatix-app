{
  "name": "chromatix",
  "version": "0.0.0",
  "description": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "homepage": "/",
  "scripts": {
    "start": "npm run dev",
    "dev": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite",
    "build": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite build",
    "build:analyze": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) ANALYZE=true vite build",
    "preview": "vite preview",
    "release:stage": "release-it --config .release-staging.json",
    "release:staging": "npm run release:stage",
    "release:prod": "release-it --config .release-production.json",
    "release:production": "npm run release:prod",
    "images:new": "npm run images:convert:new && npm run images:tinify:new",
    "images:all": "npm run images:convert:all && npm run images:tinify:all",
    "images:convert:new": "node lib/image-to-webp.mjs --skip-existing",
    "images:convert:all": "node lib/image-to-webp.mjs",
    "images:tinify:new": "node lib/image-tinify.mjs --skip-existing",
    "images:tinify:all": "node lib/image-tinify.mjs",
    "svg:compress:new": "node lib/svg-compress.mjs --skip-existing",
    "svg:compress:all": "node lib/svg-compress.mjs",
    "css:sort": "postcss src/**/*.scss src/**/*.module.scss --replace",
    "knip": "knip --no-config-hints",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:clear": "rm -f .eslintcache",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run knip && npm run lint && npm run prettier && npm run typecheck",
    "doctor": "react-doctor",
    "doctor:all": "react-doctor --yes",
    "doctor:json": "react-doctor --yes --json",
    "doctor:verbose": "react-doctor --yes --verbose",
    "test": "vitest --silent",
    "test:verbose": "vitest",
    "test:unit": "vitest run --silent",
    "test:unit:verbose": "vitest run",
    "test:colors": "COLORS_REPORT=true vitest run src/js/utils/getColorTokens.audit.test.ts && open test-results/colors/audit.html",
    "test:colors:baseline": "COLORS_REPORT=true COLORS_SAVE=baseline vitest run src/js/utils/getColorTokens.audit.test.ts && open test-results/colors/audit.html",
    "test:login": "node tests/setup/auth.login.mjs",
    "test:audio": "node lib/run-timed.js playwright test -c tests/audio/playwright.config.ts",
    "test:audio:failed": "node lib/run-timed.js playwright test -c tests/audio/playwright.config.ts --last-failed",
    "test:audio:gui": "playwright test -c tests/audio/playwright.config.ts --ui",
    "test:audio:report": "playwright show-report test-results/audio/report",
    "test:snapshots": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts",
    "test:snapshots:failed": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --last-failed",
    "test:snapshots:gui": "playwright test -c tests/snapshots/playwright.config.ts --ui",
    "test:snapshots:report": "playwright show-report test-results/snapshots/report",
    "test:snapshots:home": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=home",
    "test:snapshots:setup": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=setup",
    "test:snapshots:library": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=library-grid --project=library-list",
    "test:snapshots:settings": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=settings",
    "test:snapshots:ui": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=ui",
    "test:snapshots:windows": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=windows",
    "test:snapshots:dev": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=dev",
    "test:snapshots:update": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --update-snapshots",
    "test:snapshots:update:failed": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --update-snapshots --last-failed",
    "test:snapshots:update:home": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=home --update-snapshots",
    "test:snapshots:update:setup": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=setup --update-snapshots",
    "test:snapshots:update:library": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=library-grid --project=library-list --update-snapshots",
    "test:snapshots:update:settings": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=settings --update-snapshots",
    "test:snapshots:update:ui": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=ui --update-snapshots",
    "test:snapshots:update:windows": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=windows --update-snapshots",
    "test:snapshots:update:dev": "node lib/run-timed.js playwright test -c tests/snapshots/playwright.config.ts --project=dev --update-snapshots",
    "prepare": "husky"
  },
  "lint-staged": {
    "ignore": [
      "**/_archived/**"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "**/*.{json,css,scss,md}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@rematch/core": "^2.2.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "axios": "^1.20.0",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dashjs": "^5.2.1",
    "dayjs": "^1.11.23",
    "input-otp": "^1.5.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^5.3.4",
    "sass": "^1.106.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chroma-js": "^3.1.3",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-sorting": "^10.0.0",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.18",
    "release-it": "^21.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tinify": "^1.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  }
}
