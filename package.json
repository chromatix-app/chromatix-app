{
  "name": "chromatix",
  "version": "0.60.0-beta.5",
  "description": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "homepage": "/",
  "scripts": {
    "start": "npm run dev",
    "dev": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite",
    "build": "VITE_VERSION=$npm_package_version VITE_DATE=$(date +%s) vite build",
    "preview": "vite preview",
    "release:stage": "release-it --config .release-staging.json",
    "release:staging": "npm run release:stage",
    "release:prod": "release-it --config .release-production.json",
    "release:production": "npm run release:prod",
    "images:convert:new": "node lib/image-to-webp.mjs --skip-existing",
    "images:convert:all": "node lib/image-to-webp.mjs",
    "images:tinify:new": "node lib/image-tinify.mjs --skip-existing",
    "images:tinify:all": "node lib/image-tinify.mjs",
    "svg:compress": "node lib/svg-compress.mjs --skip-existing",
    "svg:compress:all": "node lib/svg-compress.mjs",
    "css:sort": "postcss src/**/*.scss src/**/*.module.scss --replace",
    "knip": "knip",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:clear": "rm -f .eslintcache",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run knip && npm run lint && npm run prettier && npm run typecheck",
    "test": "vitest --silent",
    "test:verbose": "vitest",
    "test:all": "vitest run --silent",
    "test:all:verbose": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "**/*.{json,css,scss,md}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@rematch/core": "^2.2.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.16.0",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "fast-xml-parser": "^5.7.3",
    "formik": "^2.4.9",
    "input-otp": "^1.4.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "sass": "^1.99.0",
    "semver": "^7.8.0",
    "sonner": "^2.0.7",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.5",
    "@eslint/js": "^10.0.1",
    "@types/chroma-js": "^3.1.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "lint-staged": "^17.0.3",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "postcss-sorting": "^10.0.0",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tinify": "^1.8.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5"
  }
}
